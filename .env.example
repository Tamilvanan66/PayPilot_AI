# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# MongoDB Atlas connection string, e.g.
# mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/paypilot?retryWrites=true&w=majority
# If empty, the server boots an in-memory MongoDB (demo mode, data is lost on restart).
MONGODB_URI=

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=paypilot_token
COOKIE_SECURE=false
PASSWORD_RESET_TTL_MINUTES=30

# ---- AI (OpenAI-compatible) ----
# Works with OpenAI, Azure OpenAI-compatible gateways, Groq, Together, Ollama, etc.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- PayPal Sandbox ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Public URL of this API, used by PayPal to reach /api/payments/paypal/webhook
PUBLIC_API_URL=http://localhost:5000
PAYPAL_CURRENCY=USD

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
